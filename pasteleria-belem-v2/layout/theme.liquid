<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    {% # Título, Favicon, SEO y Redes Sociales unificados %}
    {% render 'meta-tags' %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}

    <style>
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden;
      }
      
      #MainContent {
        margin: 0 !important;
        padding: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
      }

      /* Liberar las secciones y grupos de pie de página de márgenes por defecto */
      #shopify-section-sections--header_group,
      #shopify-section-sections--footer_group,
      footer,
      .footer,
      .footer-section {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

          /* ===================================================
        ESTILOS SPA - VISTAS / PESTAÑAS
        =================================================== */

      /* Vista: Quiénes Somos (Default) */
      body:not([class*="view-"]) [id*="products_catalog"],
      body:not([class*="view-"]) [id*="contact_section"],
      body:not([class*="view-"]) [id*="experienciaHomeBelem"],
      body:not([class*="view-"]) [id*="carrusel_toque_belem"],
      body.view-quienes-somos [id*="products_catalog"],
      body.view-quienes-somos [id*="contact_section"],
      body.view-quienes-somos [id*="experienciaHomeBelem"],
      body.view-quienes-somos [id*="carrusel_toque_belem"],
      body.view-quienes-somos [id*="promociones_section"] {
        display: none !important;
      }

      /* Vista: El Toque Belem  */
      body.view-toque-belem [id*="hero_banner"],
      body.view-toque-belem [id*="about_us"],
      body.view-toque-belem [id*="products_catalog"],
      body.view-toque-belem [id*="contact_section"],
      body.view-toque-belem [id*="promociones_section"] {
        display: none !important;
      }

      /* Vista: Especialidades */
      body.view-especialidades [id*="hero_banner"],
      body.view-especialidades [id*="carrusel_toque_belem"],
      body.view-especialidades [id*="experienciaHomeBelem"],
      body.view-especialidades [id*="about_us"],
      body.view-especialidades [id*="contact_section"],
      body.view-especialidades [id*="promociones_section"] {
        display: none !important;
      }

      /* Vista: Contacto */
      body.view-contacto [id*="hero_banner"],
      body.view-contacto [id*="carrusel_toque_belem"],
      body.view-contacto [id*="experienciaHomeBelem"],
      body.view-contacto [id*="about_us"],
      body.view-contacto [id*="products_catalog"],
      body.view-contacto [id*="promociones_section"] {
        display: none !important;
      }
    </style>
  </head>

  <body class="view-quienes-somos">
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script>
      function switchToBelemView(viewName) {
        // Remover clases de vistas anteriores
        document.body.classList.remove(
          'view-quienes-somos', 
          'view-toque-belem',
          'view-especialidades', 
          'view-contacto', 
          'view-home');
        
        // Asignar nueva vista
        if (viewName === 'home') {
          document.body.classList.add('view-quienes-somos');
        } else {
          document.body.classList.add('view-' + viewName);
        }

        // Scroll suave al inicio del contenido
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    </script>
  </body>
</html>