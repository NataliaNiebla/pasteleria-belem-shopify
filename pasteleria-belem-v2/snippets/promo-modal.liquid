<!-- VENTANA MODAL SUPERPUESTA DE PROMOCIONES -->
<div class="belem-promo-modal-overlay" id="belemPromoModal" onclick="closePromoModal(event)">
  <div class="belem-promo-modal-dialog" role="dialog" aria-modal="true" onclick="event.stopPropagation()">
    <button type="button" class="belem-promo-modal-close" onclick="closePromoModal()" aria-label="Cerrar ventana">✕</button>
    
    <div class="belem-promo-modal-body">
      <div class="belem-promo-modal-media">
        <img id="modalPromoImg" src="" alt="Detalle de la promoción">
        <span class="belem-promo-modal-ribbon" id="modalPromoRibbon">Oferta Especial</span>
      </div>

      <div class="belem-promo-modal-info">
        <span class="belem-promo-modal-tag" id="modalPromoTag">Promoción Belem</span>
        <h3 class="belem-promo-modal-title" id="modalPromoTitle">Título de la Promoción</h3>
        
        <p class="belem-promo-modal-desc" id="modalPromoDesc"></p>

        <div class="belem-promo-modal-benefits-box">
          <h4>¿Qué incluye este paquete?</h4>
          <ul id="modalPromoBenefitsList"></ul>
        </div>

        <div class="belem-promo-modal-conditions" id="modalPromoConditions">
          <span>* Válido ordenando directamente con nosotros. No acumulable con otras ofertas.</span>
        </div>

        <div class="belem-promo-modal-actions">
          <a href="#" target="_blank" class="btn-promo-modal-whatsapp" id="modalPromoWhatsappBtn">
            Aprovechar esta Promoción por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function openPromoModal(card) {
    if (!card) return;

    const img = card.querySelector('.promo-img-box img')?.getAttribute('src') || '';
    const ribbon = card.querySelector('.promo-badge-ribbon')?.textContent || 'Promoción';
    const tag = card.querySelector('.promo-tag')?.textContent || 'Paquete Especial';
    const title = card.querySelector('.promo-title')?.textContent || '';
    const desc = card.querySelector('.promo-desc')?.textContent || '';
    const note = card.querySelector('.promo-note')?.textContent || 'Consulta términos y condiciones.';
    
    // Extraer lista de beneficios
    const benefitItems = card.querySelectorAll('.promo-benefits li');
    const benefitsList = document.getElementById('modalPromoBenefitsList');
    benefitsList.innerHTML = '';
    benefitItems.forEach(item => {
      const li = document.createElement('li');
      li.textContent = item.textContent;
      benefitsList.appendChild(li);
    });

    document.getElementById('modalPromoImg').src = img;
    document.getElementById('modalPromoImg').alt = title;
    document.getElementById('modalPromoRibbon').textContent = ribbon;
    document.getElementById('modalPromoTag').textContent = tag;
    document.getElementById('modalPromoTitle').textContent = title;
    document.getElementById('modalPromoDesc').textContent = desc;
    document.getElementById('modalPromoConditions').innerHTML = `<span>* Vigencia: ${note}. Sujeto a disponibilidad de ingredientes del día.</span>`;

    // Mensaje preconfigurado para WhatsApp
    const phone = '526181891859';
    const msg = encodeURIComponent(`Hola Pastelería Belem, me interesa ordenar la promoción: "${title}". ¿Me podrían brindar más información sobre la disponibilidad?`);
    document.getElementById('modalPromoWhatsappBtn').href = `https://wa.me/${phone}?text=${msg}`;

    const modal = document.getElementById('belemPromoModal');
    modal.classList.add('is-active');
    document.body.style.overflow = 'hidden';
  }

  function closePromoModal(event) {
    if (event && event.target && !event.target.classList.contains('belem-promo-modal-overlay') && !event.target.classList.contains('belem-promo-modal-close')) {
      return;
    }
    const modal = document.getElementById('belemPromoModal');
    modal.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('belemPromoModal');
      if (modal && modal.classList.contains('is-active')) {
        closePromoModal();
      }
    }
  });
</script>

<style>
