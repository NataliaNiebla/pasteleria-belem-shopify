<section class="belem-contact-section" id="contacto">
  <div class="belem-contact-container">
    <div class="belem-contact-card">
      
      <div class="contact-info-col">
        <span class="contact-label">Atención y Pedidos</span>
        <h4>¿Tienes un evento especial en puerta?</h4>
        <p>Visítanos en nuestra sucursal o comunícate con nosotros para pedidos personalizados.</p>

        <!-- MAPA EMBEBIDO EXACTO DE GOOGLE STREET VIEW / MAPS -->
        <div class="contact-map-wrapper">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!3m2!1ses!2smx!4v1790657076997!5m2!1ses!2smx!6m8!1m7!1ssHB3YeFQfwA0Bw9qx2EdpA!2m2!1d24.05241692632667!2d-104.5911709121342!3f32.322624!4f0!5f0.7820865974627469" 
            width="100%" 
            height="220" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
        </div>
      </div>

      <div class="contact-actions-col">
        <div class="contact-item">
          <span class="contact-icon">📍</span>
          <div>
            <strong>Ubicación:</strong>
            <p>Calle 16 de Septiembre #101, Col. UNE, C.P. 34236, Durango, Dgo.</p>
          </div>
        </div>

        <!-- BOTONES DE NAVEGACIÓN MAPS -->
        <div class="map-buttons-group">
          <a href="https://maps.app.goo.gl/Zhr9gaUCo4MQn3QD8" target="_blank" rel="noopener noreferrer" class="belem-btn-map">
            🗺️ Abrir en Google Maps
          </a>
          <a href="https://maps.apple/p/_~n5u_HRQVgj48" target="_blank" rel="noopener noreferrer" class="belem-btn-map apple-map">
            🍎 Abrir en Apple Maps
          </a>
        </div>

        <div class="contact-item">
          <span class="contact-icon">👩‍💼</span>
          <div>
            <strong>Contacto:</strong>
            <p>Eliana Moreno Reyes (Gerente)</p>
          </div>
        </div>

        <!-- BOTÓN DE WHATSAPP DIRECTO ABAJO DE MAPS -->
        <a href="https://wa.me/526181891859?text=Hola%20Pasteler%C3%ADa%20Belem,%20me%20gustar%C3%ADa%20informaci%C3%B3n%20sobre%20un%20pedido" target="_blank" rel="noopener noreferrer" class="belem-btn-primary">
          💬 Pedir por WhatsApp: 618 189 1859
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .belem-contact-section {
    background-color: #ffffff;
    padding: 20px 0px 70px 0px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .belem-contact-container {
    width: 100% !important;
    max-width: 1600px !important;
    margin: 0 auto !important;
    box-sizing: border-box !important;
  }

  .belem-contact-card {
    background: linear-gradient(135deg, #fff2f5 0%, #ffffff 100%);
    border-radius: 28px;
    padding: 42px;
    border: 1px solid #f8bbd0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    box-shadow: 0 14px 35px rgba(216, 27, 96, 0.07);
  }

  .contact-info-col {
    max-width: 460px;
    width: 100%;
  }

  .contact-label {
    font-size: 0.82rem;
    text-transform: uppercase;
    color: #d81b60;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .contact-info-col h4 {
    font-size: 1.85rem;
    color: #3b141e;
    margin: 8px 0 12px 0;
    font-weight: 800;
    line-height: 1.25;
  }

  .contact-info-col p {
    font-size: 1.02rem;
    color: #555555;
    margin: 0 0 18px 0;
    line-height: 1.6;
  }

  .contact-map-wrapper {
    margin-top: 15px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #f8bbd0;
    box-shadow: 0 6px 16px rgba(216, 27, 96, 0.08);
  }

  .contact-actions-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: #333333;
  }

  .contact-item p {
    margin: 2px 0 0 0;
    color: #666666;
  }

  .contact-icon {
    font-size: 1.3rem;
  }

  .map-buttons-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .belem-btn-map {
    display: inline-block;
    flex: 1;
    min-width: 180px;
    background-color: #ffffff;
    color: #d81b60 !important;
    border: 2px solid #d81b60;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 10px 16px;
    border-radius: 50px;
    text-align: center;
    transition: all 0.2s ease;
  }

  .belem-btn-map:hover {
    background-color: #fff2f5;
    transform: translateY(-2px);
  }

  .belem-btn-map.apple-map {
    border-color: #444444;
    color: #333333 !important;
  }

  .belem-btn-map.apple-map:hover {
    background-color: #f5f5f5;
  }

  .belem-btn-primary {
    display: inline-block;
    background-color: #d81b60;
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 14px 28px;
    border-radius: 50px;
    text-align: center;
    box-shadow: 0 6px 18px rgba(216, 27, 96, 0.25);
    transition: all 0.2s ease;
  }

  .belem-btn-primary:hover {
    background-color: #c2185b;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(216, 27, 96, 0.35);
  }

  @media (max-width: 768px) {
    .belem-contact-card {
      flex-direction: column;
      align-items: stretch;
      padding: 30px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Tarjeta de Contacto",
  "settings": [],
  "presets": [
    {
      "name": "Tarjeta de Contacto"
    }
  ]
}
{% endschema %}