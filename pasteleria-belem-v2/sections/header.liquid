<header class="belem-header-wrapper">
  <div class="belem-header-container">
    
    <!-- Logo e Identidad -->
    <a href="{{ routes.root_url }}" class="header__logo-link" onclick="if(window.switchToBelemView){ switchToBelemView('home'); }">
      <img 
        src="{{ 'logo-belem.png' | asset_url }}" 
        alt="Pastelería Belem" 
        class="header__logo-img"
        width="54"
        height="54"
        loading="eager"
      >
      <span class="header__brand-name">Pastelería Belem</span>
    </a>

  <!-- Barra de Navegación con Botones / Píldoras -->
    <nav class="header__nav" aria-label="Navegación principal">
    <!-- Botón de Inicio -->
      <a 
        href="javascript:void(0)" 
        class="header__nav-btn" 
        onclick="switchToBelemView('home')"
      >
        <span>Inicio</span>
      </a>

      <!-- Botón de Quiénes Somos -->
      <a 
        href="javascript:void(0)" 
        class="header__nav-btn" 
        onclick="switchToBelemView('quienes-somos')"
      >
        <span>Quiénes Somos</span>
      </a>

      <!-- "El Toque Belem" -->
      <a 
        href="javascript:void(0)" 
        class="header__nav-btn" 
        onclick="switchToBelemView('toque-belem')"
      >
        <span>El Toque Belem</span>
      </a>

      <!-- Correcto: Pasa 'especialidades' y muestra "Especialidades" -->
      <a 
        href="javascript:void(0)" 
        class="header__nav-btn" 
        onclick="switchToBelemView('especialidades')"
      >
        <span>Especialidades</span>
      </a>

      <a 
        href="javascript:void(0)" 
        class="header__nav-btn" 
        onclick="switchToBelemView('contacto')"
      >
        <span>Contacto</span>
      </a>
    </nav>

    <!-- Botón CTA Pedidos -->
    <div class="header__actions">
      <a 
        href="https://wa.me/526181891859?text=Hola%20Pasteler%C3%ADa%20Belem,%20me%20gustar%C3%ADa%20hacer%20un%20pedido" 
        target="_blank" 
        rel="noopener noreferrer"
        class="header__cta-btn"
      >
        <span>Pedir por WhatsApp</span>
      </a>
    </div>

  </div>
</header>

{% stylesheet %}
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
  }

  .belem-header-wrapper {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #f3e5e8;
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 4px 18px rgba(59, 20, 30, 0.04);
  }

  .belem-header-container {
    width: 100%;
    margin: 0;
    padding: 0.65rem 2.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Logo */
  .header__logo-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .header__logo-link:hover {
    transform: scale(1.02);
  }

  .header__logo-img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: contain;
    background: #ffffff;
    border: 2px solid #fce4ec;
    box-shadow: 0 4px 10px rgba(216, 27, 96, 0.12);
  }

  .header__brand-name {
    font-size: 1.22rem;
    font-weight: 800;
    color: #3b141e;
    letter-spacing: -0.4px;
    font-family: inherit;
  }

  /* Navegación y Botones */
  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff5f7;
    padding: 4px 6px;
    border-radius: 50px;
    border: 1px solid #fde2e7;
  }

  .header__nav-btn {
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    color: #4a2830;
    padding: 0.45rem 1.15rem;
    border-radius: 50px;
    transition: all 0.22s ease;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }

  .header__nav-btn:hover {
    background-color: #ffffff;
    color: #d81b60;
    box-shadow: 0 2px 8px rgba(216, 27, 96, 0.12);
  }

  /* CTA WhatsApp */
  .header__actions {
    display: flex;
    align-items: center;
  }

  .header__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #d81b60;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.55rem 1.25rem;
    border-radius: 50px;
    box-shadow: 0 4px 14px rgba(216, 27, 96, 0.25);
    transition: all 0.2s ease;
  }

  .header__cta-btn:hover {
    background-color: #ad1457;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(216, 27, 96, 0.35);
  }

  @media (max-width: 860px) {
    .header__brand-name {
      display: none;
    }
    .belem-header-container {
      padding: 0.6rem 1rem;
    }
    .header__nav-btn {
      padding: 0.38rem 0.75rem;
      font-size: 0.82rem;
    }
    .header__cta-btn {
      padding: 0.45rem 0.85rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 580px) {
    .header__nav {
      gap: 0.2rem;
      padding: 3px;
    }
    .header__nav-btn {
      padding: 0.35rem 0.55rem;
      font-size: 0.78rem;
    }
    .header__cta-btn span {
      display: none;
    }
    .header__cta-btn::after {
      content: "Pedir";
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": []
}
{% endschema %}