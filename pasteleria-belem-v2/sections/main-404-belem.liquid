<section class="belem-404-section">
  <div class="belem-404-container">
    <div class="belem-404-card">
      <span class="belem-404-badge">Ups, receta no encontrada</span>
      <h1 class="belem-404-title">404</h1>
      <h2 class="belem-404-subtitle">¡Se nos terminó este pan o la página no existe!</h2>
      <p class="belem-404-text">
        El enlace que intentas abrir no está disponible o cambió de lugar. No te quedes con el antojo y regresa a nuestra vitrina principal.
      </p>
      <div class="belem-404-actions">
        <a href="{{ routes.root_url }}" class="belem-404-btn primary-btn">
          ← Volver a la Tienda
        </a>
        <a 
          href="https://wa.me/526181891859?text=Hola%20Pastelería%20Belem,%20buscaba%20un%20producto%20pero%20no%20lo%20encontré%20en%20la%20página" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="belem-404-btn secondary-btn"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .belem-404-section {
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at top, #fff5f7 0%, #ffffff 70%);
    padding: 60px 20px;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .belem-404-container {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .belem-404-card {
    background: #ffffff;
    border: 1px solid #f8d7df;
    border-radius: 28px;
    padding: 55px 36px;
    box-shadow: 0 16px 40px rgba(59, 20, 30, 0.06);
  }

  .belem-404-badge {
    display: inline-block;
    background-color: #ffebee;
    color: #d81b60;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 18px;
    border-radius: 50px;
    margin-bottom: 12px;
  }

  .belem-404-title {
    font-size: clamp(4.5rem, 10vw, 7rem);
    font-weight: 900;
    color: #7d1234;
    margin: 0;
    line-height: 1;
    letter-spacing: -2px;
  }

  .belem-404-subtitle {
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    color: #3b141e;
    font-weight: 800;
    margin: 16px 0 12px 0;
  }

  .belem-404-text {
    font-size: 1rem;
    color: #666666;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto 32px auto;
  }

  .belem-404-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .belem-404-btn {
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 26px;
    border-radius: 50px;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .primary-btn {
    background-color: #d81b60;
    color: #ffffff !important;
    box-shadow: 0 6px 16px rgba(216, 27, 96, 0.25);
  }

  .primary-btn:hover {
    background-color: #ad1457;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(216, 27, 96, 0.35);
  }

  .secondary-btn {
    background-color: #ffffff;
    color: #7d1234 !important;
    border: 1px solid #f8bbd0;
  }

  .secondary-btn:hover {
    background-color: #fff0f3;
    transform: translateY(-2px);
  }
</style>

{% schema %}
{
  "name": "Página 404 Belem",
  "settings": []
}
{% endschema %}