<script>
  function filterProducts(category, btn) {
    const cards = document.querySelectorAll('.product-card');
    const buttons = document.querySelectorAll('.filter-btn');
    
    buttons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    cards.forEach(card => {
      if (category === 'all' || card.getAttribute('data-category') === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

<style>
.belem-products-section {
    background: #ffffff; /* Mismo fondo */
    padding: 30px 24px 80px 24px; /* Bajamos el padding-top de 85px a solo 30px */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .belem-products-container {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
  }

  .belem-products-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 40px auto;
  }

  .belem-products-title {
    font-size: 2.6rem;
    color: #3b141e;
    font-weight: 800;
    margin: 12px 0 10px 0;
    letter-spacing: -0.5px;
  }

  .belem-products-subtitle {
    font-size: 1.12rem;
    color: #555555;
    line-height: 1.6;
    margin: 0;
  }

  /* Barra de filtros interactiva */
  .belem-filter-bar {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 50px;
  }

  .filter-btn {
    border: 1px solid #f2d8df;
    background: #fffafa;
    color: #555;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 10px 22px;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    background: #ffebee;
    color: #d81b60;
    border-color: #f8bbd0;
  }

  .filter-btn.active {
    background: #d81b60;
    color: #ffffff;
    border-color: #d81b60;
    box-shadow: 0 4px 15px rgba(216, 27, 96, 0.3);
  }

  /* Grid de Tarjetas */
  .belem-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }

  .product-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #f3e6e8;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(74, 21, 37, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(74, 21, 37, 0.1);
    border-color: #f8bbd0;
  }

  /* Caja de imagen cuadrada con bordes suaves */
  .product-img-box {
    position: relative;
    width: 100%;
    height: 230px;
    background-color: #fff4f6;
    overflow: hidden;
  }

  .product-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-img-box img {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: #d81b60;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(216, 27, 96, 0.3);
  }

  /* Detalles del producto */
  .product-details {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: #ad1457;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .product-name {
    font-size: 1.25rem;
    color: #3b141e;
    font-weight: 800;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .product-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: #666;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid #f6eaed;
  }

  .product-label-status {
    font-size: 0.8rem;
    font-weight: 700;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 4px 10px;
    border-radius: 8px;
  }

  .btn-order-card {
    background: #d81b60;
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 8px 20px;
    border-radius: 50px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(216, 27, 96, 0.2);
  }

  .btn-order-card:hover {
    background: #ad1457;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(216, 27, 96, 0.35);
  }

  @media (max-width: 600px) {
    .belem-products-section {
      padding: 50px 16px;
    }
    .belem-products-title {
      font-size: 2rem;
    }
  }
</style>

