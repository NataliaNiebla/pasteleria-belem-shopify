    margin: 0 0 12px 0;
    line-height: 1.2;
  }

  .belem-promo-modal-desc {
    font-size: 0.96rem;
    line-height: 1.6;
    color: #444444;
    margin: 0 0 18px 0;
  }

  .belem-promo-modal-benefits-box {
    background: #fffafa;
    border: 1px solid #f8e6ea;
