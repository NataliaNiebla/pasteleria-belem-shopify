<!-- Importación del snippet modal independiente -->
{% render 'product-modal' %}

<script>
  /* Función para filtrar tarjetas por categoría */
  function filterProducts(category, btn) {
    const cards = document.querySelectorAll('.product-card');
    const buttons = document.querySelectorAll('.filter-btn');
    
    buttons.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    cards.forEach(card => {
      if (category === 'all' || card.getAttribute('data-category') === category) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  /* Controlador SPA multiventana */
  window.switchToBelemView = function(view) {
    document.body.classList.remove('view-especialidades', 'view-promociones');

    if (view === 'especialidades') {
      document.body.classList.add('view-especialidades');
      window.location.hash = 'especialidades';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else if (view === 'promociones') {
      document.body.classList.add('view-promociones');
      window.location.hash = 'promociones';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      history.pushState("", document.title, window.location.pathname + window.location.search);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    // Escuchar enlaces hacia Especialidades
    document.querySelectorAll('a[href="#especialidades"], a[href="#menu-productos"]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        window.switchToBelemView('especialidades');
      });
    });

    // Escuchar enlaces hacia Promociones
    document.querySelectorAll('a[href="#promociones"]').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        window.switchToBelemView('promociones');
      });
    });

    // Detectar si carga con hash en la URL
    if (window.location.hash === '#especialidades') {
      window.switchToBelemView('especialidades');
    } else if (window.location.hash === '#promociones') {
      window.switchToBelemView('promociones');
    }
  });
</script>

<style>
  /* Por defecto en la página de inicio, la sección de productos no se muestra al dar scroll */
  #menu-productos {
    display: none;
    animation: fadeInView 0.35s ease forwards;
  }

  /* Cuando el usuario activa la vista de especialidades, se muestra el catálogo */
  body.view-especialidades #menu-productos {
    display: block;
  }

  /* Se ocultan el Hero y Quiénes Somos para mostrar únicamente la vitrina */
  body.view-especialidades .belem-hero-main,
  body.view-especialidades .belem-about-section {
    display: none !important;
  }

  /* Barra de botón volver alineada al ancho del contenedor */
  .belem-back-home-bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    margin: 0 auto;
    padding: 12px 0 20px 0;
